# Copy this file to .env and fill only the connectors you use.
# Never commit the real .env file.

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_PROJECT_NUMBER=28

GITLAB_TOKEN=
GITLAB_DEFAULT_PROJECT_ID=
GITLAB_BASE_URL=https://gitlab.com

# Initial neutral hierarchy. Names do not need to be globally unique.
MAXWELL_ORGANIZATION_NAME=
MAXWELL_PROJECT_NAME=IRN
MAXWELL_PRODUCT_NAME=IRN
MAXWELL_GITLAB_ACCOUNT_NAME=

OPENPROJECT_API_URL=
OPENPROJECT_API_TOKEN=

# Optional standalone Codex CLI executable override. `codex` resolves from PATH;
# on Windows an absolute npm-installed codex.cmd path is also supported.
# Authentication stays in Codex's own local session; run `codex login` instead
# of putting an OpenAI key in Ahive.
AHIVE_CODEX_EXECUTABLE=codex

# Optional standalone OpenCode CLI executable override. `opencode` resolves
# from PATH; on Windows an absolute npm-installed opencode.cmd path is also
# supported. Authentication stays in OpenCode's own local credentials; run
# `opencode auth login` instead of putting provider API keys in Ahive.
AHIVE_OPENCODE_EXECUTABLE=opencode

# Opt-in local diagnostic trace. Includes OpenCode's full command argv and
# prompt in server-console [agent-trace] lines. Never commit a real .env file.
AHIVE_AGENT_TRACE_VERBOSE=false

# Google OAuth 2.0 Web application credentials. The redirect URI must exactly
# match an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4173/api/google/oauth/callback
# Optional alternative to the local OAuth flow. Normally leave this blank;
# Maxwell stores the refresh token in the Git-ignored data/google-oauth.json.
GOOGLE_REFRESH_TOKEN=
# Default used when creating a Google Sheets Product Source.
GOOGLE_SHEET_TAB=Tasks

# Absolute directories agents may access. Separate multiple roots with the
# operating-system path delimiter (semicolon on Windows, colon on Unix).
AHIVE_REPOSITORY_ROOTS=
# Absolute directory used only for Ahive-managed Git worktrees. Worktrees use
# deterministic Repository/Run subdirectories and are never cleaned silently.
AHIVE_WORKTREE_ROOT=
# Maximum verification commands running through the main server at once (1-8).
# Each MCP process additionally permits only one command for its owning Run.
AHIVE_VERIFICATION_CONCURRENCY=2
# Private content-addressed Run Artifact storage and retention.
AHIVE_ARTIFACT_ROOT=data/run-artifacts
AHIVE_ARTIFACT_RETENTION_DAYS=30
# Optional development/test overrides. Relative paths resolve from the project.
AHIVE_DATABASE_PATH=data/ahive.db
AHIVE_LEGACY_STORE_PATH=data/maxwell.json
